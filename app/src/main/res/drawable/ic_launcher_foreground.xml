                android:strokeColor="#D9DEE8"
                android:strokeWidth="1.6"
                android:strokeLineCap="round"
                android:pathData="M75,77.4H82" />
        </group>
        <!--
            One tiny arm, bent at the elbow, ending in a mitten hand on the capsule. A darker edge lets it show against
            the body, and a patch of body colour hides that edge at the shoulder, so the arm grows out of the chest.
        -->
        <path
            android:strokeColor="#C9502B"
            android:strokeWidth="6.6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M59.2,65.4C60.6,69.4 62.8,71.7 65.6,72L69.6,71.2" />
        <path

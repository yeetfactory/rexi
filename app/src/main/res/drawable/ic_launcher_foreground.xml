        <group
            android:pivotX="67"
            android:pivotY="74"
            android:rotation="-32">
            <path android:fillColor="#3D6FD8" android:pathData="M67,67.5H53A6.5,6.5 0,0 0,53 80.5H67Z" />
            <path android:fillColor="#FFFFFF" android:pathData="M67,67.5H81A6.5,6.5 0,0 1,81 80.5H67Z" />
            <path

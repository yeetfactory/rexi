            android:pathData="M67.4,70.6a3.4,3.4 0,1 0,6.8 0a3.4,3.4 0,1 0,-6.8 0 M68.65,67.6a1.95,1.95 0,1 0,3.9 0a1.95,1.95 0,1 0,-3.9 0" />
        <path android:fillColor="#F0683F" android:pathData="M55.9,65.4a3.3,3.3 0,1 0,6.6 0a3.3,3.3 0,1 0,-6.6 0" />
        <path
            android:strokeColor="#F0683F"
            android:strokeWidth="5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M59.2,65.4C60.6,69.4 62.8,71.7 65.6,72L69.6,71.2" />
        <path
            android:fillColor="#F0683F"
            android:pathData="M68.2,70.6a2.6,2.6 0,1 0,5.2 0a2.6,2.6 0,1 0,-5.2 0 M69.45,67.6a1.15,1.15 0,1 0,2.3 0a1.15,1.15 0,1 0,-2.3 0" />

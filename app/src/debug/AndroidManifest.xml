<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. Fills the app with sample medicines and two weeks of history, for screenshots and testing. -->
<!-- Only adb can send it: the shell holds DUMP, and no ordinary app can. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.SampleData"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
